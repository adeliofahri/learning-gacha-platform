# ── Database (PostgreSQL) ───────────────────────────────────────────────
# Lokal (docker-compose): kedua nilai sama.
#   postgresql://postgres:postgres@localhost:5432/learning_gacha?schema=public
# Neon (production/Vercel):
#   DATABASE_URL = connection string "Pooled" (host mengandung "-pooler"),
#                  tambahkan &pgbouncer=true&connect_timeout=15
#   DIRECT_URL   = connection string tanpa pooler (untuk prisma migrate)
DATABASE_URL=
DIRECT_URL=

# Secret acak minimal 32 karakter. Buat dengan: openssl rand -base64 48
AUTH_SECRET=
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta

# Opsional: password akun demo yang dibuat seed (default hanya untuk development)
# SEED_ADMIN_PASSWORD=
# SEED_STUDENT_PASSWORD=

RESEND_API_KEY=
EMAIL_FROM="Learning Gacha <verification@domainmu.com>"
